# Modo de execução (true para simulador mock local, false para terminal real)
MODO_TESTE_LOCAL=false

# Host Real TN3270
HOST="192.168.1.100"
PORT=992
SECURE_CONNECTION=true

# Host para modo de teste local
LOCAL_HOST="127.0.0.1"

# Credenciais do Operador na Aplicação Legada
APP_MATRICULA="OP-0000"
APP_SENHA="senha_operador_exemplo"

# Timeouts e Controle de Concorrência
LOCK_TIMEOUT_SECONDS=30.0
TERMINAL_TIMEOUT_SECONDS=15.0
CADENCIA_ENVIO_SEGUNDOS=0.05

# Configurações da API FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# ==============================================================================
# GATILHOS DE IDENTIFICAÇÃO DE TELAS 3270 (MATRIZ 24x80)
# ==============================================================================
GATILHO_TELA_APLICACAO="ENTRE COM A APLICACAO"
GATILHO_TELA_LOGIN="CICSCNTR"
GATILHO_TELA_MENU="CEUSPL02"
GATILHO_TELA_SUBMENU="SPPC/CONSULTA"
GATILHO_TELA_SOLICITANTE="Matric D"
GATILHO_TELA_LISTA="Aquisicao"
GATILHO_LISTA_TEMPO_SERVICO="SPPC/CONATS"
GATILHO_LISTA_FALTAS="SPPC/CONFLT"
GATILHO_LISTA_LICENCAS="SPPC/CONLCA"
GATILHO_LISTA_PUNICOES="SPPC/CONPUE"
GATILHO_SEM_REGISTROS="Não existem"
GATILHO_TELA_DETALHE="NC5F"
GATILHO_FIM_SESSAO="ENTRE COM A APLICACAO"
GATILHO_USUARIO_CONECTADO="usuario ja conectado"
GATILHO_ACESSO_NEGADO="Acesso negado"
GATILHO_MATRICULA_INEXISTENTE="Matricula Inexiste no Cadastro"
PREFIXO_ERRO_TELA_SOLICITANTE=">>>"

# ==============================================================================
# COORDENADAS (LINHA/COLUNA 1-INDEXED) E OPÇÕES DE NAVEGAÇÃO 3270
# ==============================================================================
# 1ª Tela: Seleção de Aplicação (PRODAM)
POS_APLICACAO_LINHA=23
POS_APLICACAO_COLUNA=7
OPCAO_APLICACAO="A"

# 2ª Tela: Login CICS (CICSCNTR)
POS_LOGIN_MATRICULA_LINHA=20
POS_LOGIN_MATRICULA_COLUNA=14
POS_LOGIN_SENHA_LINHA=21
POS_LOGIN_SENHA_COLUNA=14

# 3ª Tela: Menu de Sistemas (CEUSPL02)
POS_MENU_LINHA=23
POS_MENU_COLUNA=23
OPCAO_MENU_PRINCIPAL="5"

# 4ª Tela: Menu de Consultas (SPPC/CONSULTA)
POS_SUBMENU_LINHA=22
POS_SUBMENU_COLUNA=14

# 5ª Tela: Consulta de Férias do Servidor (SPPC/CONFER - PC05 M05A)
POS_SOLICITANTE_MATRICULA_LINHA=9
POS_SOLICITANTE_MATRICULA_COLUNA=9
POS_SOLICITANTE_DIGITO_LINHA=9
POS_SOLICITANTE_DIGITO_COLUNA=16
POS_SOLICITANTE_SEQUENCIA_LINHA=9
POS_SOLICITANTE_SEQUENCIA_COLUNA=18
POS_SOLICITANTE_SITUACAO_LINHA=15
POS_SOLICITANTE_SITUACAO_COLUNA=24
OPCAO_SOLICITANTE_SITUACAO=""

# 6ª Tela: Tabela de Registros de Férias e Ações
LINHA_INICIAL_REGISTROS=11
LINHA_FINAL_REGISTROS=20
COLUNA_CHECKBOX_MARCAR=3
CARACTERE_MARCACAO_REGISTRO="X"
TECLA_PF_ENCERRAR=3
TECLA_PF_AVANCAR_PAGINA=8
